# Server-side Gemini key. Do not expose this in client-side code.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also supported by the current Google GenAI SDK.
GOOGLE_API_KEY=

# Production Cloud Run mode: use Vertex/Gemini through Google Cloud ADC.
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=business-heroes-infinity
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: pin model for production consistency.
GEMINI_MODEL=gemini-2.5-flash

# Local development persistence. Ignored by Git.
VIDSLOOM_ENV=local
VIDSLOOM_STORAGE=local
VIDSLOOM_DATA_DIR=.vidsloom-data
VIDSLOOM_RENDER_DYNAMIC_ASSETS=true
VIDSLOOM_RENDER_MAX_ASSETS=5
VIDSLOOM_RENDER_CONCURRENCY=2
# Optional async planning and render queues. Cloud Run deploys default to environment-specific queues.
VIDSLOOM_PLANNING_QUEUE=
VIDSLOOM_PLANNING_QUEUE_LOCATION=asia-southeast1
VIDSLOOM_PLANNING_WORKER_URL=
VIDSLOOM_RENDER_QUEUE=
VIDSLOOM_RENDER_QUEUE_LOCATION=asia-southeast1
VIDSLOOM_RENDER_WORKER_URL=
VIDSLOOM_PUBLISHING_QUEUE=
VIDSLOOM_PUBLISHING_QUEUE_LOCATION=asia-southeast1
VIDSLOOM_PUBLISHING_WORKER_URL=
# In Cloud Run, set this to a Google Cloud Storage bucket for generated MP4/poster persistence.
VIDSLOOM_GENERATED_ASSET_BUCKET=

# SendGrid follow-up engine. Use Secret Manager in Cloud Run for SENDGRID_API_KEY.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=VIDSLOOM
SENDGRID_REPLY_TO_EMAIL=
VIDSLOOM_SALES_EMAIL=
SENDGRID_NOTIFY_EMAIL=
SENDGRID_LEAD_AUTORESPONDER_TEMPLATE_ID=
SENDGRID_OWNER_LEAD_TEMPLATE_ID=
SENDGRID_MARKETING_LIST_IDS=
SENDGRID_CONTACTDB_LIST_IDS=

# Optional free/owned direct-contact CTAs. These create wa.me, sms:, and mailto links;
# they do not send paid SMS or WhatsApp messages from the server.
VIDSLOOM_WHATSAPP_NUMBER=
VIDSLOOM_SMS_NUMBER=
VIDSLOOM_CONTACT_PREFILL=

# Social OAuth and direct publishing. Configure only after each platform developer app
# and required publishing scopes are approved. Tokens are encrypted before storage.
VIDSLOOM_TOKEN_ENCRYPTION_SECRET=
VIDSLOOM_YOUTUBE_CLIENT_ID=
VIDSLOOM_YOUTUBE_CLIENT_SECRET=
VIDSLOOM_YOUTUBE_PRIVACY_STATUS=private
VIDSLOOM_TIKTOK_CLIENT_KEY=
VIDSLOOM_TIKTOK_CLIENT_SECRET=
VIDSLOOM_TIKTOK_DEFAULT_PRIVACY=SELF_ONLY
VIDSLOOM_META_APP_ID=
VIDSLOOM_META_APP_SECRET=
VIDSLOOM_META_GRAPH_VERSION=v20.0
VIDSLOOM_LINKEDIN_CLIENT_ID=
VIDSLOOM_LINKEDIN_CLIENT_SECRET=
VIDSLOOM_LINKEDIN_VERSION=202605

# Stripe paid activation. In Cloud Run these are mounted from Secret Manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
