{
  "name": "vidsloom",
  "version": "0.1.0",
  "private": true,
  "description": "VIDSLOOM AI-operated short-form video marketing engine for small businesses.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "samples:promote-restaurant": "node scripts/promote-staging-restaurant-sample.mjs",
