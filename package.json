    "next": "latest",
    "pureimage": "^0.4.18",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.4",
    "eslint-config-next": "latest",
    "puppeteer-core": "^25.1.0",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20.11"
  }
