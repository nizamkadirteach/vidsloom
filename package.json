    "samples:self-promo": "node scripts/generate-vidsloom-self-promo-samples.mjs",
    "e2e:production-pilot": "node scripts/run-production-e2e-pilot.mjs",
    "visual:videos": "node scripts/visual-qa-videos.mjs",
    "visual:videos:ai": "node scripts/ai-visual-qa-videos.mjs",
    "visual:pages": "node scripts/visual-qa-pages.mjs",
    "visual:pages:ai": "node scripts/ai-visual-qa-pages.mjs",
    "visual:video-file": "node scripts/visual-qa-video-file.mjs",
    "visual:video-file:ai": "node scripts/ai-visual-qa-video-file.mjs",
    "check": "npm run typecheck && npm run build && npm run visual:videos && npm run visual:pages"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "latest",
